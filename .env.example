# OpenAI — GPT-4o text polishing
VITE_OPENAI_KEY=sk-...

# GitHub — report JSON storage
# Token needs: repo > contents (read + write)
VITE_GITHUB_TOKEN=ghp_...
# Format: owner/repo  e.g.  manan/cdham-reports
VITE_GITHUB_REPO=owner/repo
# Path to the JSON file inside the repo  e.g.  data/cdham-reports.json
VITE_GITHUB_FILE=data/cdham-reports.json
